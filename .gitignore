# SwiftBeaverLodge .gitignore

# =============================================================================
# Tauri / Rust
# =============================================================================

# Rust build artifacts
/src-tauri/target/
/target/

# Cargo lock (keep for reproducible builds, but some prefer to ignore)
# Cargo.lock

# Rust analyzer
/.rust-analyzer/

# =============================================================================
# Node.js / Frontend
# =============================================================================

# Dependencies
/node_modules/

# Build output
/build/
/dist/
/.svelte-kit/

# Vite
/vite.config.ts.timestamp-*

# Package manager files
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# IDE / Editors
# =============================================================================

# VS Code (keep settings but ignore history/local)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.#*

# =============================================================================
# OS Generated
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Testing / Coverage
# =============================================================================

/coverage/
*.lcov
.nyc_output/

# =============================================================================
# Environment / Secrets
# =============================================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# =============================================================================
# Logs
# =============================================================================

logs/
*.log

# =============================================================================
# SwiftBeaver Specific
# =============================================================================

# Upstream reference repo (for investigation only, not part of build)
/swiftbeaver-upstream/

# Test evidence files (potentially large)
*.dd
*.raw
*.E01
*.E??
*.L01
*.L??

# Test output directories
/test-output/
/test_output/
/output/

# Golden image test artifacts
tests/golden_image/golden.raw
tests/golden_image/golden.E01

# =============================================================================
# Build Artifacts / Releases
# =============================================================================

# Tauri build outputs
/src-tauri/target/release/bundle/

# Release artifacts
*.AppImage
*.deb
*.rpm
*.msi
*.exe
*.dmg

# =============================================================================
# Temporary Files
# =============================================================================

tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# =============================================================================
# Documentation Build
# =============================================================================

/docs/_build/
/docs/api/
